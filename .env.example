# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side only, used by n8n / ingestion (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the Meta lead webhook (n8n) must send to the ingestion endpoint
LEAD_INGEST_SECRET=change-me-to-a-long-random-string
